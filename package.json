{
  "name": "@webship-js/django-cms-steps",
  "version": "2.1.0",
  "description": "webship-js step definitions for testing django CMS sites: login by registry handle, the toolbar and its menus, the modal and the sideframe, the create wizard, the structure board and plugins, versions, the page tree, users and permissions, languages, the navigation menu and the breadcrumb.",
  "main": "index.js",
  "files": [
    "index.js",
    "tests/step-definitions",
    "tests/features",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:examples": "node scripts/check-examples.js",
    "test:dry-run": "cucumber-js --config cucumber.js --dry-run",
    "site:start": "cd ${SITE_DIR:-site} && ddev start",
    "site:stop": "cd ${SITE_DIR:-site} && ddev stop",
    "site:seed": "cd ${SITE_DIR:-site} && ddev exec 'bash scripts/manage.sh shell < scripts/seed.py'",
    "site:empty": "cd ${SITE_DIR:-site} && ddev exec 'bash scripts/manage.sh shell < scripts/empty.py'",
    "report": "generate-reports"
  },
  "keywords": [
    "webship-js",
    "django",
    "django-cms",
    "cucumber",
    "playwright",
    "bdd",
    "testing",
    "step-definitions"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/django-cms-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/django-cms-steps/issues"
  },
  "homepage": "https://github.com/webship/django-cms-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 20.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.6"
  },
  "devDependencies": {
    "webship-js": "^2.0.6",
    "ts-node": "^10",
    "typescript": "~5.4.0"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
